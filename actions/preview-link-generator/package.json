{
  "name": "preview-link-generator-action",
  "version": "3.0.0",
  "private": true,
  "description": "Preview link generator for Open Publishing Services (OPS)-enabled docs repos. Waits for OpenPublishing.Build to complete, then extracts preview links from the OPS build report and updates the pull request body.",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "package": "ncc build lib/main.js -o dist --source-map --license licenses.txt",
    "test": "jest --detectOpenHandles",
    "all": "npm run build && npm run format && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+git@github.com:dotnet/docs-tools.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.2.6",
    "@types/node": "^18.11.18",
    "@vercel/ncc": "^0.36.0",
    "jest": "^29.3.1",
    "jest-circus": "^29.3.1",
    "js-yaml": "^5.2.2",
    "prettier": "^2.8.3",
    "ts-jest": "^29.0.5",
    "typescript": "^4.9.4"
  }
}
